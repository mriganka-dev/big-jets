# Big Jets Alert - Frontend Environment Configuration

# Backend API Base URL (defaults to http://localhost:4000 if not set)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Telegram Bot username without @ symbol (used for alert links)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=big_jets_alert_bot

# Show military/fighter positions on map (default: false)
NEXT_PUBLIC_SHOW_MILITARY_ON_MAP=false
